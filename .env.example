# Telegram application details from https://my.telegram.org
API_ID=123456
API_HASH=replace_me
BOT_TOKEN=123456:replace_me
# APP_ID and TG_BOT_TOKEN are accepted as aliases for API_ID and BOT_TOKEN.

# Numeric Telegram IDs. The bot must be an administrator in both channels.
CHANNEL_ID=-1001234567890
FORCE_SUB_CHANNEL_1=-1001234567891
# FORCE_SUB_CHANNEL is accepted as an alias for FORCE_SUB_CHANNEL_1.
# FORCE_SUB_CHANNEL_2 / FORCE_SUB_CHANNEL2 are ignored by this version.

# Optional second button. Set this in Railway to any valid Telegram or web URL.
# It does not count as a required subscription.
DUMMY_BUTTON_LINK=https://example.com
DUMMY_BUTTON_TEXT=Join Channel 2 ↗

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=request_join_file_bot
# DATABASE_URL and DATABASE_NAME are accepted aliases.

# Bot administrators (space-separated numeric user IDs)
OWNER_ID=123456789
ADMINS=123456789

# True: bot approves the request and sends the pending file automatically.
# False: a channel administrator approves it; the user then taps Retry.
AUTO_APPROVE_JOIN_REQUESTS=True

# Optional text shown for /start without a share payload.
START_MESSAGE=<b>Welcome, {first_name}.</b> Send me a file share link to retrieve a file.

# Optional message shown above the request-to-join buttons.
FORCE_SUB_MESSAGE=Please request to join our channel first.
